<launch>
  <!-- Real mission, simulated services/events; no CAN or actuators. -->
  <node pkg="robot_navigation" type="mission_controller_node" name="mission_controller_node" required="true">
    <rosparam file="$(find robot_navigation)/config/mission_params.yaml"/>
    <param name="mission/state_machine_rate_hz" value="50.0"/>
    <param name="mission/medicine_placed_event_timeout_sec" value="0.3"/>
    <param name="skip_bedside_scan" value="true"/>
    <param name="bedside_scan_skip_wait_s" value="0.0"/>
    <param name="enable_vl53_circle_check" value="false"/>
  </node>
  <test pkg="robot_navigation" type="test_mission_medicine_event.py" test-name="mission_medicine_event" time-limit="35"/>
</launch>
