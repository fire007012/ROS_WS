<launch>
  <!-- Starts real motion once. Run only with arm/drug boxes clear. -->
  <arg name="can_device" default="can0"/>
  <arg name="bed_id" default="1"/>
  <arg name="box_id" default="1"/>
  <arg name="arm_config" default="$(find arm_and_gripper)/config/arm_and_gripper.yaml"/>
  <include file="$(find arm_and_gripper)/launch/arm_and_gripper.launch">
    <arg name="can_device" value="$(arg can_device)"/>
    <arg name="arm_config" value="$(arg arm_config)"/>
  </include>
  <node pkg="robot_navigation" type="speech_service_node.py" name="speech_service_node" output="screen"/>
  <node pkg="robot_navigation" type="arm_demo_once.py" name="arm_demo_once" output="screen">
    <param name="bed_id" value="$(arg bed_id)"/>
    <param name="box_id" value="$(arg box_id)"/>
  </node>
</launch>
