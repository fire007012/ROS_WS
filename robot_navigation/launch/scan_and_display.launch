<launch>
  <!-- Standalone camera scanning and status GUI; no motion or arm nodes. -->
  <arg name="video_device" default=""/>
  <arg name="image_width" default="640"/>
  <arg name="image_height" default="480"/>
  <arg name="framerate" default="30"/>
  <!-- Give the operator time to open the GUI and position a test QR code. -->
  <arg name="qr_timeout_sec" default="3600.0"/>
  <arg name="barcode_timeout_sec" default="3600.0"/>
  <arg name="fullscreen" default="false"/>
  <arg name="enable_gui" default="true"/>
  <include file="$(find robot_navigation)/config/camera_devices.launch">
    <arg name="camera_role" value="scan"/>
    <arg name="camera_device_override" value="$(arg video_device)"/>
    <arg name="camera_ns" value=""/>
    <arg name="camera_node" value="usb_cam"/>
    <arg name="image_width" value="$(arg image_width)"/>
    <arg name="image_height" value="$(arg image_height)"/>
    <arg name="framerate" value="$(arg framerate)"/>
    <arg name="pixel_format" value="mjpeg"/>
  </include>
  <node pkg="robot_navigation" type="barcode_qr_detector_node"
        name="barcode_qr_detector_node" output="screen">
    <param name="qr_timeout_sec" value="$(arg qr_timeout_sec)"/>
    <param name="barcode_timeout_sec" value="$(arg barcode_timeout_sec)"/>
    <param name="image_queue_size" value="1"/>
    <remap from="/barcode_bed1" to="/barcode_scan/raw_bed1"/>
    <remap from="/barcode_bed3" to="/barcode_scan/raw_bed3"/>
    <remap from="/robot_display" to="/barcode_scan/raw_display"/>
  </node>
  <node pkg="robot_navigation" type="scan_sequence_node.py"
        name="scan_sequence_node" output="screen"/>
  <group if="$(arg enable_gui)">
    <include file="$(find robot_navigation)/launch/status_display.launch">
      <arg name="fullscreen" value="$(arg fullscreen)"/>
    </include>
  </group>
</launch>


