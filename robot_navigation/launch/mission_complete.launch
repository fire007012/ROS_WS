<?xml version="1.0"?>
<!--
  ==============================================================================
   完整任务启动文件 — robot_navigation/launch/mission_complete.launch
  ==============================================================================

   启动顺序（按依赖关系）：
     1. can_motor_interface        — 底盘 CAN 通信
     2. motion_planner             — 运动规划 + 里程计
     3. arm_interface              — 机械臂 CAN 接口
     4. path_manager               — 路径管理
     5. path_tracker               — 路径跟踪
     6. fine_tuning                — 终点微调（VL53L1X）
     7. servo_controller           — 舵机控制
     8. arm_and_gripper            — 药品摆放（机械臂+舵机）
     9. barcode_qr_detector        — 二维码/条形码识别
    10. open_medicine_box          — 药箱开启控制
    11. display_node               — 屏幕显示
    12. start_signal_pub           — 启动信号转发
    13. mission_controller         — 任务状态机

   使用方式：
     roslaunch robot_navigation mission_complete.launch

   可选参数：
     enable_camera:=false          — 禁用摄像头相关节点
     mission_config:=/path/to/config  — 自定义任务配置文件
  ==============================================================================
-->
<launch>
  <rosparam file="$(find robot_navigation)/config/chassis_geometry.yaml"/>
  <arg name="enable_arm_upper_alignment" default="false"/>
  <arg name="can_device" default="can0"/>
  <arg name="tx_can_id" default="256"/>
  <arg name="rx_can_id" default="257"/>
  <arg name="use_extended_frame" default="false"/>
  <arg name="motor_indices" default="[1, 0, 3, 2]"/>
  <arg name="direction_signs" default="[1, 1, 1, 1]"/>
  <!-- ======================== 顶层开关参数 ======================== -->
  <arg name="enable_camera"       default="true"/>
  <arg name="scan_camera_device" default=""/>
  <arg name="enable_arm"          default="true"/>
  <!-- Legacy compatibility argument; Y42 joint control is no longer launched. -->
  <arg name="arm_joint_control" default="false"/>
  <arg name="enable_servo"        default="false"/>
  <!-- 比赛默认必须扫描床头柜条形码；无摄像头联调时显式传 true。 -->
  <arg name="skip_bedside_scan"   default="false"/>
  <arg name="competition_mode" default="true"/>
  <arg name="bedside_scan_skip_wait_s" default="1.0"/>
  <arg name="enable_open_medicine_box" default="true"/>
  <arg name="medicine_box_can_device" default="can0"/>
  <arg name="medicine_box_can_id" default="518"/>
  <arg name="medicine_box_servo_cmd_code" default="32"/>
  <arg name="medicine_box_open_angle_deg" default="90.0"/>
  <arg name="medicine_box_hold_duration_sec" default="1.0"/>
  <arg name="enable_vl53l1x_can" default="true"/>
  <arg name="vl53l1x_can_interface" default="can0"/>
  <arg name="vl53l1x_can_config" default="$(find robot_navigation)/config/vl53l1x_can.yaml"/>
  <!-- 整机投影校验参数：按实测车体/机械臂外接半径和传感器安装调整。 -->
  <arg name="enable_vl53_circle_check" default="true"/>
  <arg name="require_all_vl53_ranges" default="false"/> <!-- P4/P6 只要求前向校准束有效 -->
  <!-- 单位均为 m；半径应取水平投影外接圆半径，不能只填底盘中心尺寸。 -->
  <arg name="vl53_circle_timeout_sec" default="0.5"/> <!-- 传感器数据最大允许年龄 -->
  <arg name="vl53_min_clearance_m" default="0.05"/> <!-- 底盘四路 Range 的最小有效距离 -->
  <arg name="base_projection_radius_m" default="0.25"/> <!-- 车体（不含机械臂）外接半径 -->
  <arg name="full_projection_radius_m" default="0.25"/> <!-- 车体+机械臂外接半径 -->
  <arg name="circle_boundary_margin_m" default="0.02"/> <!-- 圆/白框边界额外安全余量 -->
  <arg name="front_range_topic" default="/front/range"/>
  <arg name="left_range_topic" default="/left/range"/>
  <arg name="right_range_topic" default="/right/range"/>
  <arg name="rear_range_topic" default="/rear/range"/>
  <arg name="use_dynamic_navigation" default="false"/>
  <arg name="enable_range_avoidance" default="true"/>
  <arg name="range_avoidance_config" default="$(find path_manager)/config/range_avoidance.yaml"/>
  <!-- Required when use_dynamic_navigation:=true. -->
  <arg name="dynamic_map_file" default="/absolute/path/to/arena.yaml"/>
  <!-- STM32 CAN1 0x112 is the authoritative physical start event. -->
  <arg name="enable_physical_start" default="false"/>
  <arg name="enable_can_start_signal" default="true"/>
  <arg name="enable_audio_video" default="true"/>
  <arg name="audio_role" default="slave"/>
  <arg name="audio_local_ip" default="$(optenv ROS_IP 0.0.0.0)"/>
  <arg name="audio_remote_ip" default="$(optenv ROBOT_VM_IP)"/>
  <arg name="audio_ready_topic" default="/Ready"/>
  <!-- 外部测量装置接口：提供自己的 launch 后再启用，默认不伪造节点。 -->
  <arg name="enable_patient_measurement" default="true"/>
  <arg name="patient_measurement_launch"
       default="$(find robot_navigation)/launch/patient_measurement_interface.launch"/>
  <arg name="heart_rate_topic" default="/vitals/heart_rate"/>
  <arg name="temperature_topic" default="/vitals/temperature"/>

  <arg name="enable_gui" default="true"/>
  <arg name="scan_pixel_format" default="mjpeg"/>
  <arg name="scan_mode" default="auto"/>
  <arg name="scan_camera_config" default="$(find robot_navigation)/config/scan_camera.yaml"/>
  <arg name="bedside_timeout_s" default="28.0"/>
  <arg name="call_duration_s" default="5.0"/>
  <!-- ======================== 配置文件路径 ======================== -->
  <arg name="robot_params"        default="$(find robot_bringup)/config/robot_params.yaml"/>
  <arg name="arm_params"          default="$(find robot_bringup)/config/arm_params.yaml"/>
  <arg name="paths_file"          default="$(find robot_bringup)/config/paths.yaml"/>
  <arg name="path_tracker_params" default="$(find robot_bringup)/config/path_tracker_forward_only.yaml"/>
  <arg name="fine_tuning_config"  default="$(find fine_tuning)/config/fine_tuning.yaml"/>
  <arg name="servo_config"        default="$(find arm_and_gripper)/config/servo_params.yaml"/>
  <arg name="arm_gripper_config"  default="$(find arm_and_gripper)/config/arm_and_gripper.yaml"/>
  <arg name="mission_config"      default="$(find robot_navigation)/config/mission_params.yaml"/>

  <!-- ======================== 全局参数加载 ======================== -->
  <rosparam file="$(arg robot_params)"   command="load"/>
  <rosparam file="$(arg arm_params)"     command="load"/>
  <rosparam file="$(arg mission_config)" command="load"/>

  <!-- ============================================================ -->
  <!--  第1层：硬件通信层                                            -->
  <!-- ============================================================ -->

  <!-- 1.1 底盘 CAN 接口 (can0) -->
  <node pkg="can_motor_interface" type="can_interface_node"
        name="can_interface_node" output="screen" required="true">
    <param name="can_device" value="$(arg can_device)"/>
    <param name="tx_can_id" value="$(arg tx_can_id)" type="int"/>
    <param name="rx_can_id" value="$(arg rx_can_id)" type="int"/>
    <param name="use_extended_frame" value="$(arg use_extended_frame)" type="bool"/>
    <param name="motor_count" value="4"/>
    <rosparam param="motor_indices" subst_value="true">$(arg motor_indices)</rosparam>
    <rosparam param="direction_signs" subst_value="true">$(arg direction_signs)</rosparam>
    <param name="max_rpm" value="3000.0"/>
    <param name="acceleration_rpm_s" value="50"/>
    <param name="report_mask" value="7"/>
    <param name="broadcast_index" value="255"/>
    <param name="heartbeat_timeout_sec" value="1.0"/>
    <param name="start_ack_timeout_sec" value="0.4"/>
  </node>

  <!-- ============================================================ -->
  <!--  第2层：运动规划层                                            -->
  <!-- ============================================================ -->

  <!-- 2.1 cmd_vel 多路复用器 -->
  <node pkg="motion_planner" type="cmd_vel_mux_node"
        name="cmd_vel_mux_node" output="screen" required="true">
    <param name="publish_rate_hz" value="30.0"/>
  </node>

  <!-- 2.2 里程计 -->
  <node pkg="motion_planner" type="base_odometry_node"
        name="base_odometry_node" output="screen" required="true">
    <param name="odom_publish_hz" value="50.0"/>
  </node>

  <!-- 2.3 运动规划器 -->
  <node pkg="motion_planner" type="planner_node"
        name="planner_node" output="screen" required="true">
    <param name="print_debug_log" value="false"/>
  </node>

  <!-- ============================================================ -->
  <!--  第3层：路径导航层                                            -->
  <!-- ============================================================ -->

  <!-- 3.1 路径管理器 -->
  <node pkg="path_manager" type="path_manager_node"
        name="path_manager_node" output="screen" required="true">
    <param name="yaml_file_path" value="$(arg paths_file)"/>
    <param name="publish_rate_hz" value="10.0"/>
    <param if="$(arg use_dynamic_navigation)" name="frame_id" value="map"/>
    <param unless="$(arg use_dynamic_navigation)" name="frame_id" value="odom"/>
  </node>

  <!-- 3.2 传统里程计路径跟踪器 -->
  <group unless="$(arg use_dynamic_navigation)">
    <node pkg="path_manager" type="path_tracker_node"
          name="path_tracker_node" output="screen" required="true">
      <rosparam file="$(arg path_tracker_params)" command="load"/>
      <rosparam file="$(arg range_avoidance_config)" command="load"/>
      <param name="range_avoidance/enabled" value="$(arg enable_range_avoidance)"/>
      <param name="range_avoidance/front_range_topic" value="$(arg front_range_topic)"/>
      <param name="range_avoidance/left_range_topic" value="$(arg left_range_topic)"/>
      <param name="range_avoidance/right_range_topic" value="$(arg right_range_topic)"/>
      <param name="range_avoidance/rear_range_topic" value="$(arg rear_range_topic)"/>
    </node>
  </group>

  <!-- 3.3 动态导航模式：YAML 路径点逐个交给 move_base；局部规划器负责绕障。 -->
  <group if="$(arg use_dynamic_navigation)">
    <node pkg="path_manager" type="move_base_path_adapter_node"
          name="move_base_path_adapter_node" output="screen" required="true">
      <param name="goal_frame" value="map"/>
      <param name="goal_timeout_sec" value="60.0"/>
    </node>
    <include file="$(find robot_navigation)/launch/dynamic_navigation.launch">
      <arg name="start_base_stack" value="false"/>
      <arg name="enable_predefined_paths" value="false"/>
      <arg name="enable_range_safety" value="false"/>
      <arg name="map_file" value="$(arg dynamic_map_file)"/>
    </include>
  </group>

  <!-- ============================================================ -->
  <!--  第4层：精确定位层                                            -->
  <!-- ============================================================ -->

  <!-- 4.1 终点微调 (VL53L1X) -->
  <node pkg="fine_tuning" type="fine_tuning_node"
        name="fine_tuning_node" output="screen" required="true">
    <rosparam file="$(arg fine_tuning_config)" command="load"/>
    <param name="auto_start_on_path_finished" value="false"/>
  </node>

  <!-- ============================================================ -->
  <!--  第5层：业务执行层                                            -->
  <!-- ============================================================ -->
  <!-- 舵机由STM32 CAN控制，不启动旧pigpio节点。 -->

  <!-- 5.2 机械臂+夹爪（可选） -->
  <group if="$(arg enable_arm)">
    <!-- DS3230MG/SG90 四步序列；旧 arm_interface/Y42 节点不再启动。 -->
    <include file="$(find arm_and_gripper)/launch/arm_and_gripper.launch">
      <arg name="arm_config" value="$(arg arm_gripper_config)"/>
      <arg name="can_device" value="$(arg can_device)"/>
    </include>
  </group>
  <!-- 5.3 药箱开启服务（由护士台二维码给出的 box_id 驱动） -->
  <group if="$(arg enable_open_medicine_box)">
    <node pkg="robot_navigation" type="open_medicine_box_node"
          name="open_medicine_box_node" output="screen" required="true">
      <param name="selection_only" value="true"/>
      <param name="can_device" value="$(arg medicine_box_can_device)"/>
      <param name="can_id" value="$(arg medicine_box_can_id)"/>
      <param name="servo_cmd_code" value="$(arg medicine_box_servo_cmd_code)"/>
      <param name="open_angle_deg" value="$(arg medicine_box_open_angle_deg)"/>
      <param name="hold_duration_sec" value="$(arg medicine_box_hold_duration_sec)"/>
    </node>
  </group>

  <!-- ============================================================ -->
  <!--  第6层：视觉感知层（可选）                                    -->
  <!-- ============================================================ -->

  <!-- 6.1 USB 摄像头驱动（需要安装 usb_cam 包） -->
  <group if="$(arg enable_camera)">
    <include file="$(find robot_navigation)/config/camera_devices.launch">
      <arg name="camera_role" value="scan"/>
      <arg name="camera_device_override" value="$(arg scan_camera_device)"/>
      <arg name="camera_node" value="usb_cam"/>
      <arg name="scan_capture_mode" value="$(arg scan_mode)"/>
      <arg name="scan_continuous" value="false"/>
      <arg name="scan_config" value="$(arg scan_camera_config)"/>
      <arg name="image_width" value="640"/>
      <arg name="image_height" value="480"/>
      <arg name="framerate" value="10"/>
      <arg name="pixel_format" value="$(arg scan_pixel_format)"/>
    </include>

    <!-- 6.2 二维码/条形码识别 -->
    <node pkg="robot_navigation" type="barcode_qr_detector_node"
          name="barcode_qr_detector_node" output="screen">
      <param name="qr_timeout_sec" value="30.0"/>
      <param name="barcode_timeout_sec" value="30.0"/>
      <param name="image_queue_size" value="1"/>
      <param name="allow_qr_updates" value="false"/>
      <param name="qr_enabled" value="false"/>
      <param name="processing_rate_hz" value="12.0"/>
    </node>
  </group>

  <!-- ============================================================ -->
  <!--  第7层：人机交互层                                            -->
  <!-- ============================================================ -->

  <!-- 7.1 显示屏节点 -->
  <node pkg="robot_navigation" type="display_node"
        name="display_node" output="screen">
    <param name="can_enable" value="false"/>
  </node>

  <!-- 7.2 启动信号转发（CAN → ROS，可关闭以仅使用车体 GPIO 按钮） -->
  <group if="$(arg enable_can_start_signal)">
    <node pkg="robot_navigation" type="start_signal_pub_node"
          name="start_signal_pub_node" output="screen">
      <param name="can_device" value="$(arg can_device)"/>
      <param name="can_id" value="274"/>
    </node>
  </group>

  <!-- 7.3 物理启动按钮（GPIO 直连） -->
  <group if="$(arg enable_physical_start)">
    <node pkg="robot_navigation" type="start_button_node"
          name="start_button_node" output="screen" required="true">
      <param name="button_pin" value="17"/>
      <param name="led_pin" value="27"/>
      <param name="debounce_ms" value="50"/>
      <param name="active_low" value="true"/>
      <param name="led_enabled" value="true"/>
    </node>
  </group>

  <!-- PC1 mission start keeps /Ready=1 through both beds and return.
       Shared defaults capture the Pi call camera at 640x480@25 from /dev/video2. -->
  <group if="$(arg enable_audio_video)">
    <include file="$(find robot_navigation)/config/audio_video_defaults.launch">
      <arg name="role" value="slave"/>
      <arg name="local_ip" value="$(arg audio_local_ip)"/>
      <arg name="remote_ip" value="$(arg audio_remote_ip)"/>
      <arg name="ready_topic" value="$(arg audio_ready_topic)"/>
      <arg name="enable_display" value="$(arg enable_gui)"/>
      <arg name="enable_image_view" value="false"/>
    </include>
  </group>
  <node pkg="robot_navigation" type="bedside_session_node.py" name="bedside_session_node" output="screen">
    <param name="audio_video_enabled" value="$(arg enable_audio_video)"/>
    <param name="patient_measurement_enabled" value="$(arg enable_patient_measurement)"/>
    <param name="timeout_s" value="$(arg bedside_timeout_s)"/>
    <param name="call_duration_s" value="$(arg call_duration_s)"/>
  </node>
  <node pkg="robot_navigation" type="robot_status_display_node.py" name="robot_status_display_node"
        output="screen" if="$(arg enable_gui)">
    <param name="fullscreen" value="true"/>
    <param name="video_topic" value="/camera/upper_display"/>
    <param name="scan_mode_topic" value="/barcode_scan/camera_mode"/>
    <param name="call_camera_status_topic" value="/lower_cam/lower_usb_cam/capture_status"/>
    <param name="video_display_fps" value="15.0"/>
  </node>

  <!-- ============================================================ -->
  <!--  第8层：安全感知层                                            -->
  <!-- ============================================================ -->

  <!-- Four chassis and two arm-upper VL53L1X sensors are supplied by the STM32 bridge. -->
  <group if="$(arg enable_vl53l1x_can)">
    <include file="$(find robot_navigation)/launch/vl53l1x_can.launch">
      <arg name="can_interface" value="$(arg vl53l1x_can_interface)"/>
      <arg name="config" value="$(arg vl53l1x_can_config)"/>
      <arg name="enable_arm_upper_alignment" value="$(arg enable_arm_upper_alignment)"/>
    </include>
  </group>

  <!-- 8.2 距离安全检测 — 持续近距离制动；绕障由动态导航局部规划器处理 -->
  <node pkg="robot_navigation" type="distance_safety_node"
        name="distance_safety_node" output="screen" required="true">
    <param name="front_range_topic" value="$(arg front_range_topic)"/>
    <param name="left_range_topic" value="$(arg left_range_topic)"/>
    <param name="right_range_topic" value="$(arg right_range_topic)"/>
    <param name="rear_range_topic" value="$(arg rear_range_topic)"/>
    <param name="safety_distance_mm" value="150.0"/>
    <param name="critical_distance_mm" value="100.0"/>
    <param name="braking_deceleration_mps2" value="1.0"/>
    <param name="reaction_time_sec" value="0.2"/>
    <param name="stop_margin_mm" value="100.0"/>
    <param name="distance_timeout_sec" value="0.5"/>
    <param name="control_rate_hz" value="20.0"/>
    <param name="command_timeout_sec" value="0.5"/>
    <param name="release_hysteresis_mm" value="30.0"/>
    <param name="rotation_clearance_mm" value="100.0"/> <!-- 圆形车体外缘的转向净空 -->
  </node>

  <!-- 外部心率/体温测量装置接入点。接口由外部 launch 提供，默认关闭。 -->
  <group if="$(arg enable_patient_measurement)">
    <include file="$(arg patient_measurement_launch)"/>
  </group>

  <!-- ============================================================ -->
  <!--  第9层：任务编排层（最顶层）                                  -->
  <!-- ============================================================ -->

  <!-- Local WAV paths override synthesized speech; keep empty until selected samples are deployed. -->
  <arg name="speech_bed1_audio_file" default="$(find robot_navigation)/audio/bed1_kai.wav"/>
  <arg name="speech_bed3_audio_file" default="$(find robot_navigation)/audio/bed3_kai.wav"/>
  <arg name="speech_speaker_device" default="default"/>

  <!-- 9.1 语音播报服务 — 文字转语音输出 -->
  <node pkg="robot_navigation" type="speech_service_node.py"
        name="speak_node" output="screen">
    <param name="language" value="zh"/>
    <param name="speed" value="1.0"/>
    <param name="volume" value="1.0"/>
    <param name="bed1_audio_file" value="$(arg speech_bed1_audio_file)"/>
    <param name="bed3_audio_file" value="$(arg speech_bed3_audio_file)"/>
    <param name="speaker_device" value="$(arg speech_speaker_device)"/>
  </node>

  <!-- 9.2 系统健康监控 — 关键话题检测 + 急停转发 -->
  <node pkg="robot_navigation" type="health_monitor_node"
        name="health_monitor_node" output="screen">
    <param name="publish_rate_hz" value="1.0"/>
    <param name="max_consecutive_failures" value="3"/>
  </node>

  <!-- 9.3 任务状态机 — 编排全部任务流程 -->
  <node pkg="robot_navigation" type="mission_controller_node"
        name="mission_controller_node" output="screen" required="true">
      <param name="skip_bedside_scan" value="$(arg skip_bedside_scan)"/>
      <param name="competition_mode" value="$(arg competition_mode)"/>
      <param name="audio_video_enabled" value="$(arg enable_audio_video)"/>
      <param name="bedside_scan_skip_wait_s" value="$(arg bedside_scan_skip_wait_s)"/>
      <param name="patient_measurement_enabled" value="$(arg enable_patient_measurement)"/>
      <param name="heart_rate_topic" value="$(arg heart_rate_topic)"/>
      <param name="temperature_topic" value="$(arg temperature_topic)"/>
      <param name="enable_arm_upper_alignment" value="$(arg enable_arm_upper_alignment)"/>
      <param name="enable_vl53_circle_check" value="$(arg enable_vl53_circle_check)"/>
      <param name="require_all_vl53_ranges" value="$(arg require_all_vl53_ranges)"/>
      <param name="vl53_circle_timeout_sec" value="$(arg vl53_circle_timeout_sec)"/>
      <param name="vl53_min_clearance_m" value="$(arg vl53_min_clearance_m)"/>
      <param name="base_projection_radius_m" value="$(arg base_projection_radius_m)"/>
      <param name="full_projection_radius_m" value="$(arg full_projection_radius_m)"/>
      <param name="circle_boundary_margin_m" value="$(arg circle_boundary_margin_m)"/>
      <param name="front_range_topic" value="$(arg front_range_topic)"/>
      <param name="left_range_topic" value="$(arg left_range_topic)"/>
      <param name="right_range_topic" value="$(arg right_range_topic)"/>
      <param name="rear_range_topic" value="$(arg rear_range_topic)"/>
    <rosparam file="$(arg mission_config)" command="load"/>
  </node>

</launch>
