<?xml version='1.0' encoding='utf-8'?>
<launch>
  <arg name="role" />
  <arg name="master_uri" />
  <arg name="local_ip" />
  <arg name="remote_ip" />
  <arg name="enable_audio" />
  <arg name="enable_video" />
  <arg name="enable_display" />
  <arg name="start_lower_cam" />
  <arg name="use_test_camera" />
  <arg name="lower_cam_device" />
  <arg name="cam_width" />
  <arg name="cam_height" />
  <arg name="cam_framerate" />
  <arg name="cam_pixel_format" />
  <arg name="jpeg_quality" />
  <arg name="stream_width" />
  <arg name="stream_height" />
  <arg name="stream_framerate" />
  <arg name="http_port" />
  <arg name="enable_http" />
  <arg name="enable_browser" />
  <arg name="sample_rate" />
  <arg name="frame_duration_ms" />
  <arg name="opus_bitrate" />
  <arg name="ready_topic" />
  <arg name="capture_latency_ms" />
  <arg name="playback_latency_ms" />
  <arg name="jitter_buffer_ms" />
  <arg name="max_queue_ms" />
  <arg name="start_upper_cam" />
  <arg name="upper_cam_device" />
  <arg name="rx_port" />
  <arg name="tx_port" />
  <arg name="mic_device" />
  <arg name="speaker_device" />
  <arg name="local_camera_ns" value="$(eval 'upper_cam' if arg('role') == 'master' else 'lower_cam')" />
  <arg name="local_camera_node" value="$(eval 'upper_usb_cam' if arg('role') == 'master' else 'lower_usb_cam')" />
  <arg name="remote_camera_ns" value="$(eval 'lower_cam' if arg('role') == 'master' else 'upper_cam')" />
  <arg name="remote_display_topic" value="$(eval '/camera/lower_display' if arg('role') == 'master' else '/camera/upper_display')" />
  <arg name="remote_view_node" value="$(eval 'view_lower_cam' if arg('role') == 'master' else 'view_upper_cam')" />
  <env name="ROS_MASTER_URI" value="$(arg master_uri)" />
  <env name="ROS_IP" value="$(arg local_ip)" />
  <group if="$(arg enable_video)">
    <group if="$(eval arg('start_upper_cam') if arg('role') == 'master' else arg('start_lower_cam'))">
      <node pkg="usb_cam" type="usb_cam_node" name="$(arg local_camera_node)" output="screen" ns="$(arg local_camera_ns)" unless="$(arg use_test_camera)">
        <param name="video_device" value="$(eval arg('upper_cam_device') if arg('role') == 'master' else arg('lower_cam_device'))" />
        <param name="image_width" value="$(arg cam_width)" />
        <param name="image_height" value="$(arg cam_height)" />
        <param name="framerate" value="$(arg cam_framerate)" />
        <param name="pixel_format" value="$(arg cam_pixel_format)" />
        <param name="io_method" value="mmap" />
      </node>
      <node pkg="robot_navigation" type="test_camera.py" name="$(arg local_camera_node)" output="screen" ns="$(arg local_camera_ns)" if="$(arg use_test_camera)">
        <param name="image_width" value="$(arg cam_width)" />
        <param name="image_height" value="$(arg cam_height)" />
        <param name="framerate" value="$(arg cam_framerate)" />
      </node>
      <node pkg="robot_navigation" type="video_stream_node" name="video_sender_$(arg role)" output="screen">
        <param name="camera_topic" value="/$(arg local_camera_ns)/$(arg local_camera_node)/image_raw" />
        <param name="compressed_topic" value="/$(arg local_camera_ns)/network/compressed" />
        <param name="enable_http" value="false" />
        <param name="enable_ros_topic" value="true" />
        <param name="enable_local_display" value="false" />
        <param name="jpeg_quality" value="$(arg jpeg_quality)" />
        <param name="stream_width" value="$(arg stream_width)" />
        <param name="stream_height" value="$(arg stream_height)" />
        <param name="framerate" value="$(arg stream_framerate)" />
        <param name="ready_topic" value="$(arg ready_topic)" />
      </node>
    </group>
    <node pkg="robot_navigation" type="video_stream_node" name="video_stream_$(arg role)" output="screen">
      <param name="camera_topic" value="/$(arg remote_camera_ns)/network/compressed" />
      <param name="input_compressed" value="true" />
      <param name="enable_ros_topic" value="false" />
      <param name="enable_http" value="$(arg enable_http)" />
      <param name="http_port" value="$(arg http_port)" />
      <param name="enable_local_display" value="$(arg enable_display)" />
      <param name="local_display_topic" value="$(arg remote_display_topic)" />
      <param name="jpeg_quality" value="$(arg jpeg_quality)" />
      <param name="stream_width" value="$(arg stream_width)" />
      <param name="stream_height" value="$(arg stream_height)" />
      <param name="framerate" value="$(arg stream_framerate)" />
      <param name="ready_topic" value="$(arg ready_topic)" />
    </node>
    <node pkg="image_view" type="image_view" name="$(arg remote_view_node)" output="screen" if="$(arg enable_display)">
      <remap from="image" to="$(arg remote_display_topic)" />
      <param name="queue_size" value="1" />
    </node>
    <node pkg="robot_navigation" type="video_stream_node" name="video_stream_$(arg role)_http2" output="screen" if="$(arg enable_browser)">
      <param name="camera_topic" value="/$(arg remote_camera_ns)/network/compressed" />
      <param name="input_compressed" value="true" />
      <param name="enable_ros_topic" value="false" />
      <param name="enable_http" value="true" />
      <param name="http_port" value="8081" />
      <param name="enable_local_display" value="false" />
      <param name="stream_width" value="$(arg stream_width)" />
      <param name="stream_height" value="$(arg stream_height)" />
      <param name="framerate" value="$(arg stream_framerate)" />
      <param name="ready_topic" value="$(arg ready_topic)" />
    </node>
  </group>
  <node pkg="robot_navigation" type="audio_chat_node" name="audio_chat_$(arg role)" output="screen" if="$(arg enable_audio)">
    <param name="role" value="$(arg role)" />
    <param name="local_ip" value="$(arg local_ip)" />
    <param name="remote_ip" value="$(arg remote_ip)" />
    <param name="sample_rate" value="$(arg sample_rate)" />
    <param name="frame_duration_ms" value="$(arg frame_duration_ms)" />
    <param name="opus_bitrate" value="$(arg opus_bitrate)" />
    <param name="ready_topic" value="$(arg ready_topic)" />
    <param name="capture_latency_ms" value="$(arg capture_latency_ms)" />
    <param name="playback_latency_ms" value="$(arg playback_latency_ms)" />
    <param name="jitter_buffer_ms" value="$(arg jitter_buffer_ms)" />
    <param name="max_queue_ms" value="$(arg max_queue_ms)" />
    <param name="rx_port" value="$(arg rx_port)" />
    <param name="tx_port" value="$(arg tx_port)" />
    <param name="channels" value="1" />
    <param name="mic_device" value="$(arg mic_device)" />
    <param name="speaker_device" value="$(arg speaker_device)" />
  </node>
</launch>
