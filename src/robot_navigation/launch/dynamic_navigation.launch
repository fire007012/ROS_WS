<?xml version="1.0"?>
<!--
  ==============================================================================
   动态导航启动文件 — robot_navigation/launch/dynamic_navigation.launch
  ==============================================================================

  基于 AMCL + move_base 的动态导航方案，替代固定路线模式。

  使用方式：
    roslaunch robot_navigation dynamic_navigation.launch map_file:=/absolute/path/to/arena.yaml

  前置条件：
    - 已构建场地地图（map_server 加载）
    - 已安装 move_base, amcl, teb_local_planner 包

  与固定路线模式的区别：
    - 使用全局+局部代价地图进行实时路径规划
    - AMCL 提供实时定位
    - 局部规划器可动态避障
    - 适合随机障碍物场景
  ==============================================================================
-->
<launch>
  <!-- This launch owns the base stack. Do not run it alongside
       complete_navigation.launch or mission_complete.launch. -->
  <arg name="start_base_stack" default="true"/>
  <arg name="robot_params" default="$(find robot_bringup)/config/robot_params.yaml"/>
  <arg name="can_device" default="can0"/>
  <arg name="paths_file" default="$(find robot_bringup)/config/paths.yaml"/>
  <arg name="enable_predefined_paths" default="true"/>

  <!-- ======================== 地图 ============================ -->

  <!-- A map is an installation artifact, so require the caller to provide it. -->
  <arg name="map_file"/>
  <arg name="use_map_server" default="true"/>

  <!-- Optional close-range fail-safe. It is not a substitute for /scan. -->
  <arg name="enable_range_safety" default="false"/>
  <arg name="vl53l1x_can_config" default="$(find robot_navigation)/config/vl53l1x_can.yaml"/>

  <group if="$(arg use_map_server)">
    <node pkg="map_server" type="map_server"
          name="map_server" args="$(arg map_file)"/>
  </group>

  <!-- ======================== 底盘与安全仲裁 ==================== -->
  <group if="$(arg start_base_stack)">
    <include file="$(find can_motor_interface)/launch/can_interface.launch">
      <arg name="can_device" value="$(arg can_device)"/>
    </include>
    <include file="$(find motion_planner)/launch/planner.launch">
      <arg name="params_file" value="$(arg robot_params)"/>
      <arg name="enable_twist_test" value="false"/>
      <arg name="enable_fixed_route" value="false"/>
    </include>
  </group>

  <group if="$(arg enable_range_safety)">
    <include file="$(find robot_navigation)/launch/vl53l1x_can.launch">
      <arg name="config" value="$(arg vl53l1x_can_config)"/>
      <arg name="can_interface" value="$(arg can_device)"/>
    </include>
    <node pkg="robot_navigation" type="distance_safety_node"
          name="distance_safety_node" output="screen" required="true">
      <param name="safety_distance_mm" value="300.0"/>
      <param name="critical_distance_mm" value="100.0"/>
      <param name="braking_deceleration_mps2" value="1.0"/>
      <param name="reaction_time_sec" value="0.2"/>
      <param name="stop_margin_mm" value="300.0"/>
    </node>
  </group>

  <!-- Existing YAML paths are converted to sequential move_base goals.  Do not
       run path_tracker_node in this mode: move_base is the route controller. -->
  <group if="$(arg enable_predefined_paths)">
    <rosparam file="$(arg paths_file)" command="load" ns="path_manager"/>
    <node pkg="path_manager" type="path_manager_node"
          name="path_manager_node" output="screen" required="true">
      <param name="yaml_file_path" value="$(arg paths_file)"/>
      <param name="publish_rate_hz" value="10.0"/>
    </node>
    <node pkg="path_manager" type="move_base_path_adapter_node"
          name="move_base_path_adapter_node" output="screen" required="true">
      <param name="goal_frame" value="map"/>
      <param name="goal_timeout_sec" value="60.0"/>
    </node>
  </group>

  <!-- ======================== 定位 ============================ -->

  <!-- AMCL — 自适应蒙特卡洛定位 -->
  <node pkg="amcl" type="amcl" name="amcl" output="screen">
    <remap from="scan" to="/scan"/>

    <param name="min_particles" value="100"/>
    <param name="max_particles" value="2000"/>
    <param name="kld_err" value="0.01"/>
    <param name="update_min_d" value="0.05"/>
    <param name="update_min_a" value="0.1"/>
    <param name="resample_interval" value="2"/>
    <param name="transform_tolerance" value="0.5"/>

    <param name="odom_model_type" value="diff-corrected"/>
    <param name="odom_alpha1" value="0.2"/>
    <param name="odom_alpha2" value="0.2"/>
    <param name="odom_alpha3" value="0.2"/>
    <param name="odom_alpha4" value="0.2"/>

    <param name="initial_pose_x" value="0.0"/>
    <param name="initial_pose_y" value="0.0"/>
    <param name="initial_pose_a" value="0.0"/>
  </node>

  <!-- ======================== 导航 ============================ -->

  <!-- move_base — 全局 + 局部路径规划 -->
  <node pkg="move_base" type="move_base" name="move_base"
        output="screen" respawn="false">
    <!-- move_base must never publish directly to the motor command topic. -->
    <remap from="cmd_vel" to="/cmd_vel_external"/>

    <!-- 规划器选择 -->
    <param name="base_global_planner" value="global_planner/GlobalPlanner"/>
    <param name="base_local_planner" value="teb_local_planner/TebLocalPlanner"/>

    <!-- 通用参数 -->
    <param name="controller_frequency" value="10.0"/>
    <param name="planner_frequency" value="5.0"/>

    <!-- 全局代价地图 -->
    <rosparam ns="global_costmap" subst_value="true">
      global_frame: map
      robot_base_frame: base_link
      update_frequency: 5.0
      publish_frequency: 2.0
      static_map: true
      rolling_window: false
      transform_tolerance: 0.5
      plugins:
        - {name: static_layer,    type: "costmap_2d::StaticLayer"}
        - {name: obstacle_layer,  type: "costmap_2d::ObstacleLayer"}
        - {name: inflation_layer, type: "costmap_2d::InflationLayer"}
      obstacle_layer:
        observation_sources: scan
        scan: {data_type: LaserScan, topic: /scan, marking: true, clearing: true,
               obstacle_range: 3.0, raytrace_range: 3.5}
    </rosparam>

    <!-- 局部代价地图 -->
    <rosparam ns="local_costmap" subst_value="true">
      global_frame: odom
      robot_base_frame: base_link
      update_frequency: 10.0
      publish_frequency: 5.0
      static_map: false
      rolling_window: true
      width: 4.0
      height: 4.0
      resolution: 0.05
      transform_tolerance: 0.5
      plugins:
        - {name: obstacle_layer,  type: "costmap_2d::ObstacleLayer"}
        - {name: inflation_layer, type: "costmap_2d::InflationLayer"}
      obstacle_layer:
        observation_sources: scan
        scan: {data_type: LaserScan, topic: /scan, marking: true, clearing: true,
               obstacle_range: 3.0, raytrace_range: 3.5}
    </rosparam>

    <!-- 全局规划器 (A*) -->
    <rosparam ns="GlobalPlanner" subst_value="true">
      use_dijkstra: false
      use_quadratic: true
      use_grid_path: false
      old_navfn_behavior: false
    </rosparam>

    <!-- TEB 局部规划器 -->
    <rosparam ns="TebLocalPlanner" subst_value="true">
      max_vel_x: 1.0
      max_vel_x_backwards: 0.2
      max_vel_y: 1.0
      max_vel_theta: 2.0
      acc_lim_x: 0.5
      acc_lim_y: 0.5
      acc_lim_theta: 1.0

      holonomic_robot: true
      min_turning_radius: 0.0

      dt_ref: 0.3
      dt_hysteresis: 0.1
      min_obstacle_dist: 0.25
      include_costmap_obstacles: true
      costmap_obstacles_behind_robot_dist: 1.0

      xy_goal_tolerance: 0.08
      yaw_goal_tolerance: 0.10
      free_goal_vel: false

      obstacle_poses_affected: 30
    </rosparam>

    <!-- costmap 通用 -->
    <param name="obstacle_range" value="3.0"/>
    <param name="raytrace_range" value="3.5"/>
    <rosparam param="footprint">
      [[-0.25, -0.20], [-0.25, 0.20], [0.25, 0.20], [0.25, -0.20]]
    </rosparam>
    <param name="inflation_radius" value="0.30"/>
    <param name="cost_scaling_factor" value="3.0"/>

    <!-- 目标容差 -->
    <param name="xy_goal_tolerance" value="0.08"/>
    <param name="yaw_goal_tolerance" value="0.10"/>
  </node>

</launch>
